# HTTP / HTTPS
PORT=3000
SESSION_SECRET=change-me-in-production

# MQTT Broker
# Pokud je nastaveno, aplikace se připojí k brokeru a přijímá měření přes MQTT.
# Bez tohoto nastavení běží simulátor placeholder dat.
MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC_PREFIX=hitachi
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Prostředí (development / production)
# V production + broker aktivní se simulátor nevypne automaticky.
NODE_ENV=development
